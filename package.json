{
  "name": "data-explorer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare_examples.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare_examples.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/app_check.mjs",
    "test:browser:dev": "BROWSER_SERVER=dev node scripts/app_check.mjs",
    "prepare:vectors": "uv run --cache-dir .cache/uv --script scripts/prepare_vectors.py",
    "prepare:booking": "node scripts/prepare_booking.mjs && node scripts/prepare_examples.mjs",
    "prepare:dbrd": "python3 scripts/prepare_dbrd.py && node scripts/prepare_examples.mjs",
    "probe:dutch-data": "node scripts/probe_dutch_data.mjs && node scripts/prepare_examples.mjs",
    "test:dutch-examples": "node scripts/dutch_examples_check.mjs",
    "test:words": "node scripts/words_check.mjs",
    "test:words:dev": "BROWSER_SERVER=dev node scripts/words_check.mjs",
    "check": "eslint . && python3 scripts/check_size.py && node scripts/check_size.mjs && uv run --offline --cache-dir .cache/uv ruff check . && uv run --offline --cache-dir .cache/uv ruff format --check .",
    "feasibility": "node scripts/browser_check.mjs",
    "test:terms": "uv run --cache-dir .cache/uv --script tests/check_terms.py",
    "test:terms:browser": "node scripts/terms_check.mjs",
    "test:terms:dev": "BROWSER_SERVER=dev node scripts/terms_check.mjs"
  },
  "dependencies": {
    "@bokeh/bokehjs": "3.8.0",
    "@huggingface/transformers": "4.3.1",
    "@irbisadm/statfmt": "0.1.1",
    "fflate": "0.8.3",
    "papaparse": "5.5.3",
    "pyodide": "0.29.0",
    "umap-js": "1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-visitor-keys": "4.2.1",
    "espree": "10.4.0",
    "globals": "16.5.0",
    "playwright": "1.58.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
