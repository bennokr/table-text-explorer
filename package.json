{
  "name": "data-explorer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare_examples.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare_build.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --grep-invert embeddings",
    "test:browser:dev": "BROWSER_SERVER=dev playwright test --grep-invert embeddings",
    "prepare:sentences": "node scripts/prepare_assets.mjs --model-only",
    "test:sentences:wasm": "node scripts/sentences_check.mjs",
    "prepare:vectors": "uv run --cache-dir .cache/uv --script scripts/prepare_vectors.py",
    "prepare:booking": "node scripts/prepare_booking.mjs && node scripts/prepare_examples.mjs",
    "prepare:dbrd": "python3 scripts/prepare_dbrd.py && node scripts/prepare_examples.mjs",
    "prepare:rechtspraak": "python3 scripts/prepare_rechtspraak.py",
    "prepare:tweedekamer": "python3 scripts/prepare_tweedekamer.py",
    "eval:rechtspraak": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run --cache-dir .cache/uv --script tests/eval/run.py",
    "eval:calibrate-screen": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run --cache-dir .cache/uv --script tests/eval/calibrate_screen.py",
    "test:eval": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run --cache-dir .cache/uv --script tests/eval/check_harness.py",
    "prepare:rmc": "python3 scripts/generate_rmc.py",
    "test:rmc": "python3 tests/check_rmc.py",
    "probe:dutch-data": "node scripts/probe_dutch_data.mjs && node scripts/prepare_examples.mjs",
    "check": "eslint . && python3 scripts/check_size.py && node scripts/check_size.mjs && uv run --offline --cache-dir .cache/uv ruff check . && uv run --offline --cache-dir .cache/uv ruff format --check .",
    "feasibility": "node scripts/browser_check.mjs",
    "test:terms": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run --cache-dir .cache/uv --script tests/check_terms.py",
    "test:facets": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run --offline --cache-dir .cache/uv --script tests/check_facets.py",
    "test:quick": "npm test && npm run test:terms",
    "test:clustering": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run --offline --cache-dir .cache/uv --script tests/check_clustering.py",
    "test:clustering:wasm": "node scripts/clustering_check.mjs",
    "test:browser:smoke": "playwright test workspace layout",
    "test:browser:analysis": "playwright test analysis",
    "test:browser:models": "playwright test embeddings",
    "test:browser:all": "playwright test",
    "prepare:runtime": "node scripts/prepare_runtime.mjs",
    "build:feasibility": "node scripts/prepare_examples.mjs && vite build --mode feasibility",
    "check:bundle": "node scripts/bundle_check.mjs",
    "test:cluster-names": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run --offline --cache-dir .cache/uv --script tests/check_cluster_names.py"
  },
  "dependencies": {
    "@bokeh/bokehjs": "3.8.0",
    "@huggingface/transformers": "4.3.1",
    "@irbisadm/statfmt": "0.1.1",
    "d3-cloud": "1.2.9",
    "fflate": "0.8.3",
    "linked-codebook": "https://bennokr.github.io/linked-codebook/linked-codebook-0.9.0.tgz",
    "papaparse": "5.5.3",
    "pyodide": "0.29.0",
    "umap-js": "1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-visitor-keys": "4.2.1",
    "espree": "10.4.0",
    "globals": "16.5.0",
    "playwright": "1.58.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
