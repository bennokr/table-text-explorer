{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "fieldsMatch": "partial",
  "fields": [
    {
      "type": "string",
      "name": "review_id",
      "x-linked-codebook": {
        "identifying": true
      }
    },
    {
      "type": "string",
      "name": "text"
    },
    {
      "type": "string",
      "name": "sentiment",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "integer",
      "name": "rating",
      "categories": [
        1,
        2,
        3,
        4,
        5
      ],
      "categoriesOrdered": true,
      "x-linked-codebook": {
        "level": "ordinal",
        "values": [
          {
            "code": "1"
          },
          {
            "code": "2"
          },
          {
            "code": "3"
          },
          {
            "code": "4"
          },
          {
            "code": "5"
          }
        ],
        "closed": true
      }
    },
    {
      "type": "number",
      "name": "word_count"
    },
    {
      "type": "number",
      "name": "character_count"
    }
  ]
}
