        "identifying": true
      }
    },
    {
      "type": "datetime",
      "format": "%d/%m/%Y %H:%M:%S",
      "name": "scraped_at"
    },
    {
      "type": "string",
      "name": "_version",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "datetime",
      "name": "_imported_at"
    }
  ]
}
