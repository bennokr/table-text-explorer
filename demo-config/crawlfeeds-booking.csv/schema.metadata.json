        "identifying": true
      }
    },
    {
      "type": "string",
      "name": "hotel_name",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "string",
      "name": "hotel_address",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "string",
      "name": "country",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "number",
      "name": "average_score"
    },
    {
      "type": "string",
      "name": "review_title"
    },
    {
      "type": "string",
      "name": "reviewer_name",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "number",
      "name": "rating"
    },
    {
      "type": "string",
      "name": "reviewer_country",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "string",
      "name": "negative_review_text"
    },
    {
      "type": "string",
      "name": "positive_review_text"
    },
    {
      "type": "number",
      "name": "helpful_count"
    },
    {
      "type": "datetime",
      "name": "reviewed_at"
    },
    {
      "type": "string",
      "name": "stayed_at",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "string",
      "name": "tags",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "string",
      "name": "source",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "string",
      "name": "source_domain",
      "x-linked-codebook": {
        "level": "nominal"
      }
    },
    {
      "type": "string",
      "name": "language",
      "x-linked-codebook": {
        "level": "nominal"
      }
